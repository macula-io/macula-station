[
    {kernel, [
        {logger_level, info}
    ]},

    %% Default admin endpoint config so the station boots with
    %% `/status' + `/admin/*' available out of the box. Loopback-only
    %% per V1's model — front with ssh -L for remote access, or use
    %% `network_mode: host' in compose so healthchecks on the host
    %% can reach the loopback inside the container's net namespace.
    %% Operators override via `application:set_env/3' or `sys.config'
    %% when needed.
    {macula_station, [
        {admin, #{bind => "127.0.0.1", port => 8443}}
    ]}
].
