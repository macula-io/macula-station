[
    {kernel, [
        {logger_level, info}
    ]},

    %% Belt-and-suspenders: macula >= 4.6.0 ships this flag default
    %% true, but pin it here too so a station running an older SDK
    %% (or one running a future SDK that reverts the default for any
    %% reason) still emits the publisher-end-to-end signature on
    %% outbound `_mesh.bloom' PUBLISHes and any other station-
    %% originated pubsub. Required for the (publisher, seq) dedup
    %% in macula_station_event_dedup to fire as the primary loop
    %% kill across multi-hop relays. See macula CHANGELOG 4.6.0.
    {macula, [
        {pubsub_emit_publisher_sig, true}
    ]},

    %% Default admin endpoint config so the station boots with
    %% `/status' + `/admin/*' available out of the box. Loopback-only
    %% per V1's model — front with ssh -L for remote access, or use
    %% `network_mode: host' in compose so healthchecks on the host
    %% can reach the loopback inside the container's net namespace.
    %% Operators override via `application:set_env/3' or `sys.config'
    %% when needed.
    {macula_station, [
        {admin, #{bind => "127.0.0.1", port => 8443}}
    ]}
].
