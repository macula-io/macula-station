{application, hecate_station, [
    {description, "Hecate Station — Macula V2 reference station (skeleton, Phase 0)"},
    {vsn, "0.1.0"},
    {registered, [hecate_station_sup]},
    {mod, {hecate_station_app, []}},
    {applications, [
        kernel,
        stdlib,
        macula_identity,
        macula_record,
        macula_frame,
        macula_transport,
        macula_peering,
        macula_handler,
        macula_dht,
        macula_swim,
        macula_routing,
        macula_bootstrap,
        macula_overlay,
        macula_realm,
        macula_diagnostics
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/hecate-social/hecate-station"}]}
]}.
