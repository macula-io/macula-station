{application, hecate_station, [
    {description, "Hecate Station — Macula V2 reference station (root app)"},
    {vsn, "0.1.0"},
    {registered, [hecate_station_sup, hecate_station_identity_registry]},
    {mod, {hecate_station_app, []}},
    {applications, [
        kernel,
        stdlib,
        macula,
        hecate_frame,
        hecate_peering,
        hecate_record,
        hecate_transport,
        hecate_dht,
        hecate_swim,
        hecate_routing,
        hecate_handler,
        hecate_bootstrap,
        hecate_overlay,
        hecate_realm,
        hecate_content
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/hecate-social/hecate-station"}]}
]}.
