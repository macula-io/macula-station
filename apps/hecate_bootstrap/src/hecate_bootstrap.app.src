{application, hecate_bootstrap, [
    {description, "Hecate Station — 5-tier bootstrap cascade orchestrator"},
    {vsn, "0.1.0"},
    {registered, [hecate_bootstrap_sup]},
    {mod, {hecate_bootstrap_app, []}},
    {applications, [kernel, stdlib, crypto, inets, ssl,
                    macula, macula, hecate_record]},
    {env, [{responder, disabled}]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/hecate-social/hecate-station"}]}
]}.
