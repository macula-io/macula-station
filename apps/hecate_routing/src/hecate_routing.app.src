{application, hecate_routing, [
    {description, "Hecate Station — path computation + source-route forwarding"},
    {vsn, "0.1.0"},
    {registered, []},
    {applications, [kernel, stdlib, macula]},
    {env, []},
    {modules, [hecate_routing, hecate_routing_cache, hecate_call,
               hecate_relay, hecate_call_retry]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/hecate-social/hecate-station"}]}
]}.
