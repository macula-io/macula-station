%% rebar.config — Hecate Station umbrella, Phase 0 skeleton.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    warn_obsolete_guard
]}.

{deps, [
    %% Macula SDK — provides crypto primitives that hecate-station
    %% consumes: macula_identity (Ed25519), macula_record_cbor
    %% (deterministic CBOR), macula_blake3_nif (hashing), plus the
    %% rest of the client SDK surface (CBOR NIF, QUIC, MRI, etc).
    %% 3.10.0: macula_station_client streaming subscribe/3.
    %% 3.10.1: kind field on node_record (<<"station">> / <<"daemon">>)
    %%         — required by hecate_station_fact_publisher to route
    %%         presence facts on _mesh.station.* vs _mesh.daemon.*.
    %% 3.10.2: subscribe/3 queues until peering connects — fixes the
    %%         realm-side race where SUBSCRIBE frames were rejected
    %%         with {error, not_connected} pre-handshake.
    %% 3.10.3: handshake state-timeout drains stuck workers. Pairs
    %%         with the per-identity peering cap on the listener
    %%         (cap blocks NEW conns; SDK timeout drains EXISTING
    %%         stuck pool). PLAN_FLYING_RESTART.
    %% 3.11.0: V2 PARITY Phase 1 — macula_client pool, macula_pubsub
    %%         slice, realm-per-call station_link, V2 facade rewire.
    %%         Inbound PUBLISH-frame handling (this repo's c32e255)
    %%         consumes the new wire format. See macula CHANGELOG +
    %%         docs/migrations/V1_TO_V2_PUBSUB.md.
    %% 3.11.1: macula_record_cbor:encode/1 accepts atoms — previously
    %%         crashed function_clause when verifying a wire-decoded
    %%         record whose payload had keys atomized by the frame
    %%         decoder (e.g. hostname, kind on node_records). Without
    %%         this fix _dht.put_record from daemons fails, the realm
    %%         topology dashboard sits at 1 record per relay (only
    %%         the station's own self-signed record).
    %% 3.12.0: node_record `peers' opt — list of 32-byte pubkey
    %%         binaries identifying this node's active overlay peers.
    %%         Emitted into payload at {text, <<"peers">>}; consumed
    %%         by realm topology to draw relay-to-relay edges. The
    %%         per-identity announcer (this repo's 896d6b5) populates
    %%         it from `hecate_station_peer_observer:peers/1' on each
    %%         refresh tick — so the SDK bump is the load-bearing dep.
    {macula, "~> 3.12"}

    %% Macula SDK is the single external dep. macula_frame, macula_peering
    %% and macula_diagnostics — previously vendored as apps/hecate_*
    %% in this repo — now live in the SDK (3.6 + 3.7). The v2 macula
    %% umbrella branch is fully retired.
]}.

%% Override macula's profile list so rebar3 does not pull in macula's
%% own `prod` profile when building the dep — that profile sets
%% `{erl_opts, [no_debug_info, deterministic]}', which strips abstract
%% code from the compiled beams and breaks dialyzer ("Could not get
%% Core Erlang code for ..."). The default profile (with `debug_info')
%% is enough for everything we consume.
{overrides, [
    {override, macula, [{profiles, []}]}
]}.

{project_plugins, [rebar3_ex_doc]}.

{dialyzer, [
    {warnings, [unknown, no_return, error_handling]},
    {plt_apps, all_deps},
    {plt_extra_apps, [
        macula,
        crypto, public_key, ssl
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

{relx, [
    {release, {hecate_station, "0.1.0"}, [
        hecate_station,
        sasl
    ]},
    {sys_config, "./config/sys.config"},
    {vm_args,    "./config/vm.args"},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {include_src, false}
        ]}
    ]},
    {test, [
        {deps, [
            {proper, "1.4.0"},
            {meck, "0.9.2"}
        ]},
        {erl_opts, [nowarn_export_all, debug_info]}
    ]}
]}.

{ct_opts, [
    {sys_config, "./config/sys.config"}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/hecate-social/hecate-station">>},
    {extras, ["README.md", "LICENSE"]},
    {main, "README.md"}
]}.
