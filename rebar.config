%% rebar.config — Hecate Station umbrella, Phase 0 skeleton.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    warn_obsolete_guard
]}.

{deps, [
    %% Macula SDK — provides crypto primitives that macula-station
    %% consumes: macula_identity (Ed25519), macula_record_cbor
    %% (deterministic CBOR), macula_blake3_nif (hashing), plus the
    %% rest of the client SDK surface (CBOR NIF, QUIC, MRI, etc).
    %% 3.10.0: macula_station_client streaming subscribe/3.
    %% 3.10.1: kind field on node_record (<<"station">> / <<"daemon">>)
    %%         — required by macula_station_record_fanout to route
    %%         presence facts on _mesh.station.* vs _mesh.daemon.*.
    %% 3.10.2: subscribe/3 queues until peering connects — fixes the
    %%         realm-side race where SUBSCRIBE frames were rejected
    %%         with {error, not_connected} pre-handshake.
    %% 3.10.3: handshake state-timeout drains stuck workers. Pairs
    %%         with the per-identity peering cap on the listener
    %%         (cap blocks NEW conns; SDK timeout drains EXISTING
    %%         stuck pool). PLAN_FLYING_RESTART.
    %% 3.11.0: V2 PARITY Phase 1 — macula_client pool, macula_pubsub
    %%         slice, realm-per-call station_link, V2 facade rewire.
    %%         Inbound PUBLISH-frame handling (this repo's c32e255)
    %%         consumes the new wire format. See macula CHANGELOG +
    %%         docs/migrations/V1_TO_V2_PUBSUB.md.
    %% 3.11.1: macula_record_cbor:encode/1 accepts atoms — previously
    %%         crashed function_clause when verifying a wire-decoded
    %%         record whose payload had keys atomized by the frame
    %%         decoder (e.g. hostname, kind on node_records). Without
    %%         this fix _dht.put_record from daemons fails, the realm
    %%         topology dashboard sits at 1 record per relay (only
    %%         the station's own self-signed record).
    %% 3.12.0: node_record `peers' opt — list of 32-byte pubkey
    %%         binaries identifying this node's active overlay peers.
    %%         Emitted into payload at {text, <<"peers">>}; consumed
    %%         by realm topology to draw relay-to-relay edges. The
    %%         per-identity announcer (this repo's 896d6b5) populates
    %%         it from `macula_station_peer_observer:peers/1' on each
    %%         refresh tick — so the SDK bump is the load-bearing dep.
    %% 3.12.1: macula_station_link:call/5 gated on peer_node_id (matches
    %%         publish/4) — fixes the silent CALL drop pre-handshake.
    %% 3.13.0: V2 ADVERTISE/UNADVERTISE wire frames + the matching
    %%         `advertise' / `unadvertise' atoms in macula_frame's
    %%         frame_type. Required so peer_observer's classify/1
    %%         recognises inbound ADVERTISE frames coming from
    %%         macula-realm and routes them to the new
    %%         `macula_remote_advertise_registry'. Without 3.13.0 the
    %%         frame decoder would surface them as `{text, <<"advertise">>}'
    %%         atoms-as-binaries and the classify would fall through
    %%         to `other'.
    %% 3.15.1: macula_quic:nif_connect/8 fix — Rust signature switched
    %%         from Vec<u8> to Binary<'a> for verify_pubkey. Pre-3.15.1
    %%         every outbound connect blew up with `badarg' at the NIF
    %%         decoder boundary, blocking seed-dial bootstrap entirely.
    %% 3.15.2: macula_station_link gen_server:call wrapper specs widened
    %%         to admit `{error, term()}' returns. Required so the
    %%         wildcard `_Other -> Acc' clauses in bloom_exchange and
    %%         peering_router pass dialyzer.
    %% 3.15.3: peering_conn handshake-enter guards setopt + send_connect
    %%         against {error,_}. Pre-3.15.3 every successful TLS
    %%         handshake that died post-handshake crashed the
    %%         peering_conn child with badmatch and accumulated
    %%         SUPERVISOR crash reports.
    %% 3.16.0: pool RPC fan-out (call/5, advertise/5, unadvertise/3),
    %%         status/1 health snapshot, subscribe_callback/4 shim,
    %%         V1-legacy opts on connect/2 trigger logger:notice.
    %% 4.0.0:  V1 surface fully retired; pool-aware streaming RPC ships.
    %% 4.1.0:  accept_owner opt on macula_peering — enables this
    %%         listener to split the per-identity peering cap into
    %%         handshaking (capped) and connected (uncapped) slots,
    %%         restoring the cap to its original intent (bound stuck
    %%         handshakes) so stub fan-out can no longer starve
    %%         station↔station handshakes.
    %% 4.1.1:  safe_invoke_handler funnels {error, _} returns into
    %%         BOLT#4 call_error frames instead of RESULT frames.
    %%         Pre-4.1.1, _dht.put_record returning {error, bad_signature}
    %%         (any verification failure) crashed the peering gen_statem
    %%         at frame-sign time; every multiplexed RPC on the same
    %%         QUIC connection died with it. Realm topology subscribers
    %%         saw 30s handshake timeouts as collateral damage on every
    %%         station↔station bad-sig replication attempt.
    %% 4.2.0: handshake_complete notification carries peer_node_id —
    %%        macula_station_listener consumes it for duplicate-dial
    %%        dedupe (production stations were observed at 99 stuck
    %%        `connected' workers from a single sister-station).
    %% 4.2.1: bumped QUIC idle_timeout (60s → 300s) and keep_alive
    %%        (20s → 15s) defaults — kills the 50-60s peer_closed
    %%        cycle that was leaving realm topology dashboard sparse.
    %% 4.2.2: classify_find/1 matches wire-canonical `signature' field
    %%        instead of legacy `sig'. Was rejecting every successful
    %%        DHT find with `{error, {unexpected_reply, _}}'.
    %% 4.2.3: peering_conn `awaiting_start' postpones racing QUIC
    %%        events instead of dropping them — closes the race
    %%        INSIDE the worker's mailbox.
    %% 4.2.4: server-side `handshaking' worker takes
    %%        `controlling_process' ownership of the inbound stream
    %%        before `setopt(active, true)' — closes the bytes-route-
    %%        to-listener leak (Quinn stamps stream owner at creation
    %%        time using the conn-of-the-moment owner = listener;
    %%        setopt only flips active-delivery, doesn't transfer).
    %%        Pairs with this repo's listener stray-event forwarding
    %%        (commit 85dff3e) — together they close the entire
    %%        inbound-handshake race chain.
    %% 4.2.9: subscribe_records callback decodes wire payload before
    %%        invoking the user fun. Pairs with this repo's
    %%        record_fanout (commit 57f4c8d) publishing on
    %%        '_dht.records.<type>.stored'. Together: subscribe_records
    %%        works end-to-end. See docs/SUBSCRIBE_RECORDS_GAP.md.
    {macula, "~> 4.2.9"}

    %% Macula SDK is the single external dep. macula_frame, macula_peering
    %% and macula_diagnostics — previously vendored as apps/hecate_*
    %% in this repo — now live in the SDK (3.6 + 3.7). The v2 macula
    %% umbrella branch is fully retired.
]}.

%% Override macula's profile list so rebar3 does not pull in macula's
%% own `prod` profile when building the dep — that profile sets
%% `{erl_opts, [no_debug_info, deterministic]}', which strips abstract
%% code from the compiled beams and breaks dialyzer ("Could not get
%% Core Erlang code for ..."). The default profile (with `debug_info')
%% is enough for everything we consume.
{overrides, [
    {override, macula, [{profiles, []}]}
]}.

{project_plugins, [rebar3_ex_doc]}.

{dialyzer, [
    {warnings, [unknown, no_return, error_handling]},
    {plt_apps, all_deps},
    {plt_extra_apps, [
        macula,
        crypto, public_key, ssl
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

{relx, [
    {release, {macula_station, "0.1.0"}, [
        macula_station,
        sasl
    ]},
    {sys_config, "./config/sys.config"},
    {vm_args,    "./config/vm.args"},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {include_src, false}
        ]}
    ]},
    {test, [
        {deps, [
            {proper, "1.4.0"},
            {meck, "0.9.2"}
        ]},
        {erl_opts, [nowarn_export_all, debug_info]},
        %% Walk `test/' recursively for eunit + ct so per-slice nested
        %% test dirs (apps/macula_bootstrap/test/via_<strategy>/) get
        %% compiled. rebar3's default `extra_src_dirs' for the test
        %% profile only picks up flat `test/*.erl'.
        %%
        %% Scope to the test profile only — at top level it leaks
        %% test sources into the default profile, which makes
        %% `rebar3 dialyzer' scan apps/*/test/*_tests.erl and produce
        %% ~180 spurious "Unknown function eunit:test/1" / contract
        %% warnings against test-framework modules that aren't in the
        %% default-profile PLT. Test-profile workflows (eunit, ct)
        %% still get the recursive walk.
        {extra_src_dirs, [{"test", [{recursive, true}]}]}
    ]}
]}.

{ct_opts, [
    {sys_config, "./config/sys.config"}
]}.

{ex_doc, [
    {source_url, <<"https://codeberg.org/macula-internal/macula-station">>},
    {extras, ["README.md", "LICENSE"]},
    {main, "README.md"}
]}.
