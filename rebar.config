%% rebar.config — Hecate Station umbrella, Phase 0 skeleton.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    warn_obsolete_guard
]}.

{deps, [
    %% Macula SDK v2 — protocol primitives. Umbrella sub-apps fetched
    %% individually via {git_subdir, ...}. Will collapse to a single hex
    %% dep `{macula, "~> 2.0"}' once macula 2.0.0 is published.
    {macula,             {git_subdir, "https://github.com/macula-io/macula.git", {branch, "v2"}, "apps/macula"}},
    {macula_identity,    {git_subdir, "https://github.com/macula-io/macula.git", {branch, "v2"}, "apps/macula_identity"}},
    {macula_record,      {git_subdir, "https://github.com/macula-io/macula.git", {branch, "v2"}, "apps/macula_record"}},
    {macula_frame,       {git_subdir, "https://github.com/macula-io/macula.git", {branch, "v2"}, "apps/macula_frame"}},
    {macula_transport,   {git_subdir, "https://github.com/macula-io/macula.git", {branch, "v2"}, "apps/macula_transport"}},
    {macula_peering,     {git_subdir, "https://github.com/macula-io/macula.git", {branch, "v2"}, "apps/macula_peering"}},
    {macula_diagnostics, {git_subdir, "https://github.com/macula-io/macula.git", {branch, "v2"}, "apps/macula_diagnostics"}}
]}.

{project_plugins, [rebar3_ex_doc]}.

{dialyzer, [
    {warnings, [unknown, no_return, error_handling]},
    {plt_apps, top_level_deps}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

{relx, [
    {release, {hecate_station, "0.1.0"}, [
        hecate_station,
        sasl
    ]},
    {sys_config, "./config/sys.config"},
    {vm_args,    "./config/vm.args"},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {include_src, false}
        ]}
    ]},
    {test, [
        {erl_opts, [nowarn_export_all, debug_info]}
    ]}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/hecate-social/hecate-station">>},
    {extras, ["README.md", "LICENSE"]},
    {main, "README.md"}
]}.
