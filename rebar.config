%% rebar.config — Hecate Station umbrella, Phase 0 skeleton.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_shadow_vars,
    warn_unused_import,
    warn_obsolete_guard
]}.

{deps, [
    %% Station-protocol primitives are vendored in-tree as
    %% apps/hecate_{frame,record,identity,peering,diagnostics} —
    %% station-only code, doesn't belong in the macula SDK
    %% (macula main is a 48-module client library, scoped at v3.0.0).
    %%
    %% The single remaining v2 dep is macula_transport (Quinn QUIC
    %% NIF wrapper). It stays in the macula repo because QUIC is
    %% not station-specific. Eventual consolidation with macula
    %% main's macula_quic is tracked separately.
    {macula_transport, {git_subdir, "https://github.com/macula-io/macula.git", {branch, "v2"}, "apps/macula_transport"}}
]}.

{project_plugins, [rebar3_ex_doc]}.

{dialyzer, [
    {warnings, [unknown, no_return, error_handling]},
    {plt_apps, all_deps},
    {plt_extra_apps, [
        macula_transport,
        crypto, public_key, ssl
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

{relx, [
    {release, {hecate_station, "0.1.0"}, [
        hecate_station,
        sasl
    ]},
    {sys_config, "./config/sys.config"},
    {vm_args,    "./config/vm.args"},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {include_src, false}
        ]}
    ]},
    {test, [
        {deps, [
            {proper, "1.4.0"},
            {meck, "0.9.2"}
        ]},
        {erl_opts, [nowarn_export_all, debug_info]}
    ]}
]}.

{ct_opts, [
    {sys_config, "./config/sys.config"}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/hecate-social/hecate-station">>},
    {extras, ["README.md", "LICENSE"]},
    {main, "README.md"}
]}.
